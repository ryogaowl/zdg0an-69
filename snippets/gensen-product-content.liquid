{% doc %}
  Product-owned editorial content below the standard product gallery.
  @param {product} product - Current product.
  @param {section} section - Product section.
{% enddoc %}
{% liquid
  assign stories = product.metafields.custom.product_stories.value
  assign faqs = product.metafields.custom.product_faqs.value
  assign related_products = product.metafields.custom.related_products.value
%}
<div class="gensen-content">
  {% if stories != blank %}
    {% for story in stories %}
      <section class="gensen-story{% if story.point.value == blank %} gensen-story--intro{% endif %}">
        <div class="gensen-story__heading">
          {% if story.point.value != blank %}
            <div class="gensen-point" aria-hidden="true">
              <img class="gensen-desktop" src="{{ 'gensen-point.svg' | asset_url }}" width="80" height="80" alt="" loading="lazy">
              <img class="gensen-mobile" src="{{ 'gensen-point-mobile.svg' | asset_url }}" width="50" height="50" alt="" loading="lazy">
              <span>POINT<strong>{{ story.point.value | escape }}</strong></span>
            </div>
          {% endif %}
          <h2>{{ story.heading.value | escape }}</h2>
        </div>
        {% if story.body != blank %}<div class="gensen-story__body">{{ story.body | metafield_tag }}</div>{% endif %}
        {% if story.image.value != blank %}
          {% liquid
            assign image_layout = 'custom'
            assign story_image_url = story.image.value | image_url: width: 1440
            assign original_images = 'lake,source,facility,mineral,waterfall' | split: ','
            for original_image in original_images
              assign original_filename = 'ichido-gensen-story-' | append: original_image | append: '.jpg'
              if story_image_url contains original_filename
                assign image_layout = original_image
              endif
            endfor
          %}
          <div class="gensen-story__image gensen-story__image--{{ image_layout }}">
            {{ story.image.value | image_url: width: 1440 | image_tag: widths: '375, 640, 960, 1440', sizes: '(min-width: 990px) 640px, calc(100vw - 50px)', loading: 'lazy' }}
          </div>
        {% endif %}
      </section>
    {% endfor %}
  {% elsif product.description != blank %}
    <div class="gensen-product-description rte">
      {% if product.metafields.custom.product_catchphrase.value != blank %}
        <h2 class="gensen-catchphrase">{{ product.metafields.custom.product_catchphrase.value | escape }}</h2>
      {% endif %}
      {{ product.description }}
    </div>
  {% endif %}
  {% if faqs != blank %}
    <section class="gensen-faq gensen-panel" id="gensen-faq-{{ section.id }}">
      <h2>{{ 'gensen.faq' | t }}</h2>
      <p class="gensen-panel__subtitle">{{ 'gensen.faq_label' | t }}</p>
      <gensen-faq class="gensen-faq__items">
        {% for faq in faqs %}
          {% if faq.question.value != blank and faq.answer != blank %}
            <details class="gensen-faq__item">
              <summary>{{ faq.question.value | escape }}<span aria-hidden="true"></span></summary>
              <div class="gensen-faq__answer">{{ faq.answer | metafield_tag }}</div>
            </details>
          {% endif %}
        {% endfor %}
      </gensen-faq>
      {% if section.settings.gensen_faq_link != blank %}
        <a class="gensen-button gensen-faq-link" href="{{ section.settings.gensen_faq_link }}">
          {% render 'gensen-button-art' %}
          <span class="gensen-button__hover-art" aria-hidden="true">{% render 'gensen-button-art', kind: 'fill' %}</span>
          <span class="gensen-button__label">{{ 'gensen.faq_list' | t }}</span>
        </a>
      {% else %}
        <span class="gensen-button gensen-faq-link" aria-disabled="true">{% render 'gensen-button-art' %}<span class="gensen-button__label">{{ 'gensen.faq_list' | t }}</span></span>
      {% endif %}
    </section>
  {% endif %}
  {% if related_products != blank %}
    <section class="gensen-related gensen-panel">
      <h2>{{ 'gensen.related_title' | t }}</h2>
      <p class="gensen-panel__subtitle">{{ 'gensen.other_label' | t }}</p>
      {% for related in related_products %}
        {% if related.id != product.id and related.url != blank %}
          <a class="gensen-related__card" href="{{ related.url }}{% if template.suffix == 'gensen' %}?view=gensen{% endif %}">
            <div class="gensen-related__text">
              <h3>{% render 'gensen-product-name', product: related %}</h3>
              {% if related.metafields.custom.product_catchphrase.value != blank %}
                <p class="gensen-related__catch">{{ related.metafields.custom.product_catchphrase.value | escape }}</p>
              {% endif %}
              <div class="gensen-related__description">
                <p>{{ related.metafields.custom.product_subtitle.value | escape }}</p>
                {% if related.metafields.custom.coming_soon.value == true %}
                  <p>{{ 'gensen.preparing' | t }}</p>
                {% else %}
                  {% render 'price', product: related %}
                {% endif %}
              </div>
            </div>
            {% if related.featured_image != blank %}<div class="gensen-related__image">{{ related.featured_image | image_url: width: 650 | image_tag: loading: 'lazy', alt: related.title }}</div>{% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}
</div>
